# Opsional: notifikasi Telegram
# 1) @BotFather → /newbot → salin token
# 2) Chat bot-mu, lalu ambil chat_id (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opsional: notifikasi WhatsApp via CallMeBot (gratis/pribadi)
